---
import "../styles/global.css";
import { Font } from "astro:assets";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <Font cssVariable="--font-noto-sans" />
        <Font cssVariable="--font-eagle-bold" />
        <title>Pzordle - Planet Zoo 2 Guessing Game</title>
    </head>
    <body>
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    body {
        width: 100%;
        height: 100%;
        min-height: 100svh;
        display: grid;
        max-width: 80rem;
        margin: 0 auto;
        padding-inline: var(--spacing-07);
        padding-block: var(--spacing-07);
        box-sizing: border-box;
    }
    @media (width < 500px) {
        body {
            padding-inline: var(--spacing-05);
            padding-block: var(--spacing-05);
        }
    }
</style>
